# 生产环境变量模板：复制到服务器 /home/ubuntu/ragagent/.env（chmod 600），与 docker-compose.prod.yml 同目录。
# 敏感项用 `openssl rand -hex 16`（32 字节）与 `openssl rand -base64 36` 现生成，不要复用示例值。

DB_USER=postgres
DB_PASSWORD=<openssl rand -hex 16>
DB_NAME=RagAgent

# 模型凭据加密、临时文档、租户隔离族共用；必须恰好 32 字节，建库后不可轮换（换则已加密列不可解）。
SYSTEM_AES_KEY=<openssl rand -hex 16>

# 不设则每次启动随机生成 ⇒ 重启后全员掉登录。
JWT_SECRET=<openssl rand -base64 36>

# 镜像 tag = deploy/build-images.sh 输出的 VERSION（默认 git short sha）。
APP_VERSION=01b9820
UI_VERSION=01b9820

# ── 入库图片 OCR（可选）───────────────────────────────────────────────
# 由 deploy/docker-compose.prod.yml 里的 ocr 服务提供（RapidOCR，CPU）。
# 置空则整条 OCR 链路关闭（解析管线不再给图片做文字识别）。
OCR_ENDPOINT=http://ocr:18092
# 单篇最多送多少张图（扫描件每页一张）
OCR_MAX_PAGES=30
# 单图识别超时（秒）
OCR_TIMEOUT_SECONDS=60
# 全局并发（跨文档）：2 核机器建议 1~2；调大只会抬内存峰值
OCR_CONCURRENCY=2
# 送识别前的最长边上限（等比缩小大图，控制内存与耗时）
OCR_MAX_IMAGE_SIDE=1600
# ocr 服务镜像 tag（由 deploy/build-ocr-image.sh 构建后部署）
OCR_VERSION=latest
